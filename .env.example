# Local development only. Copy to `.env` (gitignored) and adjust if needed.
# These are placeholder credentials for the local Docker database — not secrets.
# Never put production credentials in this file.

# --- Local PostGIS (compose.yaml) ---
POSTGRES_USER=safarnama
POSTGRES_PASSWORD=safarnama_dev
POSTGRES_DB=safarnama
# Host port; 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_HOST_PORT=5433

# --- API (apps/api) ---
SAFARNAMA_DATABASE_URL=postgresql://safarnama:safarnama_dev@127.0.0.1:5433/safarnama
SAFARNAMA_ENVIRONMENT=local
# Comma-separated origins allowed to call the API from a browser.
SAFARNAMA_CORS_ORIGINS=http://localhost:3000

# --- Web (apps/web) ---
API_BASE_URL=http://127.0.0.1:8000
